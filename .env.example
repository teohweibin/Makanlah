# Placeholder values only. Never paste a real key here.
NEXT_PUBLIC_SOLANA_CLUSTER=devnet
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
# Base58 secret key of the devnet payer/mint authority. Local only — .gitignore'd.
SOLANA_PAYER_SECRET_KEY=REPLACE_WITH_YOUR_OWN_DEVNET_KEY

# Google Gemini — get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
# Optional: override the Gemini model id (default gemini-3.6-flash)
# GEMINI_MODEL=gemini-3.6-flash
# Optional: how long to wait for Gemini before degrading (ms)
# GEMINI_TIMEOUT_MS=15000
# GEMINI_PHOTO_TIMEOUT_MS=30000
